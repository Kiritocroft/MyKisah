# Admin Configuration
# Password for admin page access (e.g. /admin/login)
ADMIN_PASSWORD="your_admin_secret"

# Database Configuration (Prisma + Supabase)
# Use Transaction/Pooling mode (port 6543) for production application
DATABASE_URL="postgresql://postgres.[USERNAME]:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Use Session/Direct mode (port 5432) for Prisma schema migrations
DIRECT_URL="postgresql://postgres.[USERNAME]:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Supabase Configuration (Storage & Auth)
# Your Supabase project URL (from Settings > API dashboard)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_ID].supabase.co"

# Anon Key (public) for client-side access
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# JWT Secret for session token verification (from Settings > API > JWT Settings dashboard)
SUPABASE_JWT_SECRET="super-secret-jwt-token-from-supabase-settings"
